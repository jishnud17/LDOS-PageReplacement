Make the GUPS hot-set relocation actually reachable, and log it precisely.

Stock gups-hotset-move.c relocates the hot set at tic>=150, i.e. 150 wall-clock
seconds.  Our runs end at ~35s when the worker threads exhaust their iteration
counts, so move_hotset1 never flips and the "hotset move" dataset contains no
relocation at all (see results/gups_hotset_move_never_moved.txt).

This patch:
  1. Makes the move time configurable via GUPS_MOVE_AT_SEC (default unchanged
     at 150, so stock behaviour is preserved if the env var is absent).
  2. Logs the relocation timestamp on CLOCK_MONOTONIC -- the SAME clock the
     manager writes into timestamp_ns -- so the ground-truth event can be
     aligned to CSV rows exactly rather than estimated.
  3. Logs the mmap region base on the same line, so hot-page ground truth
     ((addr - base) mod per_thread_slice < per_thread_hotsize) is computable
     without guessing the base from the access pattern.

Apply on the CloudLab node:
    cd ~/benchmarks/workloads/gups_hemem
    git apply /path/to/gups-hotset-move-configurable.diff
    make

--- a/gups-hotset-move.c
+++ b/gups-hotset-move.c
@@ -78,20 +78,50 @@

 bool stop = false;

+/* Relocation time in seconds, overridable so the move is reachable inside a
+ * short run.  Default 150 preserves stock behaviour. */
+static uint64_t move_at_sec(void)
+{
+  const char *e = getenv("GUPS_MOVE_AT_SEC");
+  return (e != NULL) ? strtoull(e, NULL, 10) : 150;
+}
+
+/* CLOCK_MONOTONIC in ns -- must match the manager's get_time_ns() so the
+ * logged move timestamp lines up with timestamp_ns in the exported CSV. */
+static uint64_t mono_ns(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+/* Set in main() once the region is mapped, logged alongside the move. */
+void *g_region_base = NULL;
+unsigned long g_region_size = 0;
+unsigned long g_slice_bytes = 0;   /* per-thread region size */
+unsigned long g_hot_bytes = 0;     /* per-thread hot-set size */
+
 static void *timing_thread()
 {
   uint64_t tic = -1;
   bool printed1 = false;
+  uint64_t at = move_at_sec();
   for (;;) {
     tic++;
-    if (tic >= 150 && tic < 300) {
+    if (tic >= at) {
       if (!printed1) {
         move_hotset1 = true;
-        fprintf(stderr, "moved hotset1\n");
+        /* GROUND TRUTH LINE -- parsed by the analysis.  Everything needed to
+         * label pages hot/cold without reference to any measured rate. */
+        fprintf(stderr,
+                "LDOS_GROUNDTRUTH move_ns=%llu region_base=%p region_size=%lu "
+                "slice_bytes=%lu hot_bytes=%lu tic=%llu\n",
+                (unsigned long long)mono_ns(), g_region_base, g_region_size,
+                g_slice_bytes, g_hot_bytes, (unsigned long long)tic);
+        fflush(stderr);
         printed1 = true;
       }
     }
-    if (tic >= 250) {
+    if (tic >= at + 100) {
       stop = true;
     }
     sleep(1);
@@ -301,6 +331,7 @@
   }

   gettimeofday(&stoptime, NULL);
   fprintf(stderr, "Init took %.4f seconds\n", elapsed(&starttime, &stoptime));
   fprintf(stderr, "Region address: %p - %p\t size: %ld\n", p, (p + size), size);
+  g_region_base = p; g_region_size = size;

   nelems = (size / threads) / elt_size; // number of elements per thread
@@ -315,6 +346,11 @@
   hot_start = 0;
   hotsize = (tot_hot_size / threads) / elt_size;
+  g_slice_bytes = nelems * elt_size;
+  g_hot_bytes   = hotsize * elt_size;
+  fprintf(stderr,
+          "LDOS_GEOMETRY region_base=%p region_size=%lu slice_bytes=%lu "
+          "hot_bytes=%lu threads=%d elt_size=%lu\n",
+          p, size, g_slice_bytes, g_hot_bytes, threads, elt_size);
+  fflush(stderr);

   gettimeofday(&starttime, NULL);
